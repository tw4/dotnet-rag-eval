{
  // #16: are the answers supported by the retrieved text, and correct?
  "name": "answers",
  "description": "Answers generated by qwen3:4b from the top 5 chunks, judged by qwen3:8b for faithfulness (is every claim supported by the given context?) and correctness (does it agree with the reference answer?). The baseline pipeline against the choices from #12 and #13.",
  "datasets": ["turkish-rag-eval-full"],
  "judge": { "model": "qwen3:8b" },
  "runs": [
    { "name": "baseline: fixed-1000 + nomic", "chunking": { "strategy": "fixed", "size": 1000, "overlap": 200 }, "embedding": { "model": "nomic-embed-text" } },
    { "name": "structural + embeddinggemma", "chunking": { "strategy": "structural", "size": 1000 }, "embedding": { "model": "embeddinggemma" } }
  ]
}
