{
  // A fast end-to-end check of the evaluation itself: one small dataset, one run.
  "name": "smoke",
  "description": "Smoke test: the chosen pipeline (structural chunks, embeddinggemma, dense retrieval) on the 58 human-written Turkish questions.",
  "datasets": ["turkish-rag-eval"],
  "runs": [
    {
      "name": "structural-1000 / embeddinggemma / dense",
      "chunking": { "strategy": "structural", "size": 1000 },
      "embedding": { "model": "embeddinggemma" },
      "retrieval": { "strategy": "dense", "depth": 100 }
    }
  ]
}
