# Copy to .env to override the defaults used by docker-compose.yml.
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=qwen3:4b
# Use the Ollama app on the host instead of the container (faster on a Mac, which has no GPU in Docker):
# OLLAMA_URL=http://host.docker.internal:11434
# Host port for the Ollama container, if the Ollama app already uses 11434:
# OLLAMA_PORT=11435
